// th06_ps3 cxxcompat: std::mutex for gthreads-less GCC7.
// Real lv2 kernel mutex (sysMutex) - the earlier spinlock+sysThreadYield livelocked
// on RPCS3 when the BGM thread held the lock during file I/O (frame-0 hang, 3 hits).
#pragma once
#include_next <mutex>

#ifndef _GLIBCXX_HAS_GTHREADS

#ifdef __PSL1GHT__
#include <cstring>
#include <sys/mutex.h>
#elif defined(TH06_PSP)
#include <pspthreadman.h>
#endif

namespace std
{
class mutex
{
#ifdef __PSL1GHT__
    sys_mutex_t m = 0;
    bool inited = false;

    void ensure()
    {
        if (!inited)
        {
            sys_mutex_attr_t attr;
            sysMutexAttrInitialize(attr);
            std::strncpy(attr.name, "th06mtx", sizeof(attr.name));
            if (sysMutexCreate(&m, &attr) == 0)
                inited = true;
        }
    }
#elif defined(TH06_PSP)
    SceLwMutexWorkarea m{};
    bool inited = false;

    void ensure()
    {
        if (!inited && sceKernelCreateLwMutex(&m, "th06mtx", 0, 0, nullptr) >= 0)
            inited = true;
    }
#endif

  public:
    mutex() = default;
    mutex(const mutex &) = delete;
    void lock()
    {
#ifdef __PSL1GHT__
        ensure();
        if (inited)
            sysMutexLock(m, 0); // 0 = no timeout
#elif defined(TH06_PSP)
        ensure();
        if (inited)
            sceKernelLockLwMutex(&m, 1, nullptr);
#endif
    }
    void unlock()
    {
#ifdef __PSL1GHT__
        if (inited)
            sysMutexUnlock(m);
#elif defined(TH06_PSP)
        if (inited)
            sceKernelUnlockLwMutex(&m, 1);
#endif
    }
    bool try_lock()
    {
#ifdef __PSL1GHT__
        ensure();
        return inited && sysMutexTryLock(m) == 0;
#elif defined(TH06_PSP)
        ensure();
        return inited && sceKernelTryLockLwMutex(&m, 1) >= 0;
#else
        return true;
#endif
    }
};
} // namespace std
#endif
